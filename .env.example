NODE_ENV=development
PORT=3000

# Generate both locally and keep them out of git:
#   JWT_SECRET            -> openssl rand -base64 48
#   FIELD_ENCRYPTION_KEY  -> openssl rand -hex 32   (exactly 64 hex chars)
JWT_SECRET=
JWT_EXPIRES_IN=1h
FIELD_ENCRYPTION_KEY=

# Must match docker-compose.yml (local development only)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=merchant
DATABASE_PASSWORD=merchant_local_password
DATABASE_NAME=merchant_backend
REDIS_HOST=localhost
REDIS_PORT=6379
# BullMQ key prefix (the e2e tests override it so they never share a queue with this server)
QUEUE_PREFIX=bull

# Risk job retry policy (exponential backoff: delay, 2x delay, 4x delay ...)
RISK_JOB_ATTEMPTS=4
RISK_BACKOFF_MS=1000

# Sweeper that re-enqueues applications stuck in PENDING (crash between DB commit and enqueue)
RISK_RECONCILE_INTERVAL_MS=60000
RISK_RECONCILE_STALE_MS=300000

# Only used by `npm run seed` (>= 12 chars). Never commit a real value.
SEED_PASSWORD=
